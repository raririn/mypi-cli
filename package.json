{
  "name": "@raririn/mypi-source",
  "private": true,
  "version": "2.0.0-beta.12",
  "mypiRelease": {
    "name": "Roma",
    "chronicle": 1,
    "protocol": 2
  },
  "description": "Source and release tooling for the MyPi CLI",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build-runtime-packages.mjs",
    "clean": "shx rm -rf build dist packages/ai/dist packages/agent/dist packages/tui/dist packages/runtime/dist",
    "package": "pnpm build && node scripts/build-npm-package.mjs",
    "test": "pnpm test:product && pnpm test:host && pnpm test:daemon && pnpm test:hosted && pnpm test:rpc-dialogs && pnpm test:agent-hooks && pnpm test:preattach && pnpm test:distribution",
    "test:agent-hooks": "node --test tests/agent-hooks-engine.test.mjs",
    "test:distribution": "node --test tests/distribution.test.mjs",
    "test:preattach": "node --test tests/preattach.test.mjs",
    "test:host": "node --test tests/host.test.mjs tests/subagent-rpc.test.mjs tests/mcp-rpc.test.mjs",
    "test:daemon": "node --test tests/daemon.test.mjs",
    "test:hosted": "node --test tests/hosted.test.mjs tests/ownership-conflict-ui.test.mjs",
    "test:rpc-dialogs": "node --test tests/rpc-dialogs.test.mjs",
    "test:product": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/isolate-agent-dir.mjs --test packages/runtime/test/product/*.test.mts packages/runtime/test/product/*/*.test.mts",
    "test:extensions": "pnpm test:product",
    "typecheck": "tsgo --noEmit -p packages/runtime/tsconfig.build.json",
    "verify:public": "node scripts/verify-public-tree.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:runtime": "node scripts/verify-runtime-customizations.mjs",
    "verify": "pnpm verify:public && pnpm build && pnpm typecheck && pnpm test && pnpm package && pnpm verify:runtime && node scripts/verify-distribution.mjs"
  },
  "devDependencies": {
    "@bybrave/proper-lockfile2": "5.0.0",
    "@earendil-works/pi-agent-core": "workspace:0.82.1",
    "@earendil-works/pi-ai": "workspace:0.82.1",
    "@earendil-works/pi-coding-agent": "workspace:0.82.1",
    "@earendil-works/pi-tui": "workspace:0.82.1",
    "@types/node": "24.12.4",
    "@typescript/native-preview": "7.0.0-dev.20260120.1",
    "esbuild": "0.28.1",
    "shx": "0.4.0",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "packages/tui",
    "packages/ai",
    "packages/agent",
    "packages/runtime"
  ]
}
